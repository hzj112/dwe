{
  "uid": "dwe-overview",
  "title": "Workflow Engine \u2014 Operational Overview",
  "tags": [
    "dwe",
    "operations"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "label": "Process instance",
        "datasource": {
          "type": "prometheus",
          "uid": "dwe-prometheus"
        },
        "query": "label_values(up{role=~\"api|worker\"}, instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Read the signals together",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Live diagnosis:** check freshness first, then backlog, worker capacity and recovery. Durable history remains authoritative. Runbook: `OBSERVABILITY.md`. Alerts: Prometheus \u2192 Alerts."
      }
    },
    {
      "id": 1,
      "type": "row",
      "title": "01 \u00b7 Availability and capacity",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Database observations",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dwe-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(dwe_database_sample_success{role=\"api\"}) == bool 1) * (time() - max(dwe_database_sample_last_success_timestamp_seconds{role=\"api\"}) < bool 15)",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true
        }
      ],
      "description": "Fresh means the latest sample succeeded and is less than 15 seconds old. Queue panels are hidden when observations are stale.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 12
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNAVAILABLE / STALE",
                  "color": "red"
                },
                "1": {
                  "text": "FRESH",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO OBSERVATION",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "API targets UP",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dwe-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{role=\"api\"}) or vector(0)",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 12
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO OBSERVATION",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Worker targets UP",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dwe-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{role=\"worker\"}) or vector(0)",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true
        }
      ],
      "description": "Two workers are the default local target. DNS may remove a dead target entirely; compare observed capacity as workers scale.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 12
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO OBSERVATION",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Occupied worker slots",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dwe-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dwe_worker_slots_occupied{role=\"worker\"})",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true
        }
      ],
      "description": "Slots stay occupied until handler/reporting exits, including handlers that ignore cancellation. Compare with capacity below.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 12
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO OBSERVATION",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
