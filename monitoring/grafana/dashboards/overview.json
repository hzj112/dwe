    {
      "id": 6,
      "type": "row",
      "title": "02 \u00b7 Work waiting and progress \u2014 fresh database samples only",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 7,
      "title": "Runnable backlog",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dwe-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dwe_steps_ready and on(job,instance) dwe:database_sample_fresh",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Active workflows only; includes elapsed retry backoff, excludes blocked dependencies and future backoff.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Oldest runnable wait \u00b7 at last sample",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dwe-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dwe_steps_oldest_ready_seconds and on(job,instance) dwe:database_sample_fresh",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Age measured by PostgreSQL at collection time. Missing means no current observation, not an empty queue.",
