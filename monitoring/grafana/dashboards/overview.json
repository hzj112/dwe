    {
      "id": 13,
      "title": "Committed attempt outcomes / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dwe-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(dwe_events_total{event=\"attempt_finished\"}[1m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Newly committed transitions observed by this process; duplicate reports do not add completions. Crash gaps are possible; durable history is authoritative.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Handler duration \u00b7 p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 7
