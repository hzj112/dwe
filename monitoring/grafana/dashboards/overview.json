      "datasource": {
        "type": "prometheus",
        "uid": "dwe-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,outcome) (rate(dwe_operation_duration_seconds_bucket{operation=\"handler\"}[5m])))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false
