        "x": 0,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dwe-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dwe_steps_awaiting_promotion and on(job,instance) dwe:database_sample_fresh",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
