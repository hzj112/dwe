    {
      "id": 10,
      "title": "Control-loop age since last successful pass",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dwe-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dwe_loop_age_seconds",
          "legendFormat": "{{loop}} \u00b7 {{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Time since the last successful pass, or since loop initialization if no pass succeeded yet. A successful pass does not prove every workflow advanced.",
      "fieldConfig": {
        "defaults": {
