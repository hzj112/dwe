{
  "definition": {
    "steps": [
      {
        "id": "load-records",
        "actionType": "PROVIDER_LOAD"
      },
      {
        "id": "normalize-records",
        "actionType": "PROVIDER_NORMALIZE",
        "parameters": {
          "sourceStep": "load-records"
        },
        "dependsOn": [
          "load-records"
        ]
      },
      {
        "id": "validate-records",
        "actionType": "PROVIDER_VALIDATE",
        "parameters": {
          "sourceStep": "load-records",
          "demoFailFirstAttempt": true
        },
        "dependsOn": [
          "load-records"
        ],
        "retry": {
          "maxAttempts": 3,
          "backoffInitialMs": 1000,
          "backoffMaxMs": 2000
        }
      },
      {
        "id": "summarize-quality",
        "actionType": "PROVIDER_SUMMARIZE",
        "parameters": {
          "normalizedStep": "normalize-records",
          "validatedStep": "validate-records"
        },
        "dependsOn": [
          "normalize-records",
          "validate-records"
        ]
      },
      {
        "id": "publish-report",
        "actionType": "PROVIDER_FINALIZE",
        "parameters": {
          "summaryStep": "summarize-quality"
        },
        "dependsOn": [
          "summarize-quality"
        ]
      }
    ]
  },
